{
  "bot_api": {
    "debug": true
  },  
  "receiver": {
    "type": "poller",
    "allowed_updates": [
      "message",
      "edited_message",
      "channel_post",
      "edited_channel_post",
      "inline_query",
      "chosen_inline_result",
      "callback_query",
      "shipping_query",
      "pre_checkout_query",
      "poll",
      "poll_answer",
      "my_chat_member",
      "chat_member",
      "chat_join_request"],
    "buffer_size": 100,
    "webhook": {
      "listen_ip": "0.0.0.0",
      "port": "8443",
      "read_timeout": 30
    },
    "poller": {
      "offset": 0,
      "timeout": 30
    }
  }
}